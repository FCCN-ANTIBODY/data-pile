#!/usr/bin/env bash
# Verify a delivered chain: signature against the registered signer, manifest digest,
# hash-linked continuity, and per-block ciphertext hashes. No secrets needed — anyone
# can run this against a public pile.
#
# Usage: bin/verify [--dir DIR] [--source NAME]
#   --dir     directory holding inbox/ (default: repo root .)
#   --source  feed source name (default: tell). `drop` selects channel 2 (docs/transfer.md §B):
#             trust root keys/drop.signers, signature namespace `data-pile-drop`, and a
#             per-entry age-wrapped key file — its own verifier, not a relaxed one.
#   --partial A reader who holds only SOME blocks (a disclosed excerpt, an ejected piece).
#             An absent block becomes "not held" instead of fatal; everything checkable
#             without the bytes stays fatal. This is NOT a relaxed verifier — it verifies a
#             strictly smaller claim, and says so:
#               without any block bytes  -> "the signer committed to this exact ordered list
#                                            of N block hashes"   (digest + signature + chain)
#               per block actually held  -> "these bytes are the block committed at seq K"
#             Prints `verified-partial H/N`, never `verified`, so a caller can never mistake
#             one for the other. Holding every block under --partial reports the full result.
#
# Trust env (be explicit, fail closed):
#   DP_ALLOW_UNSIGNED=1   skip the signature check (only when ssh-keygen or the signers
#                         file is unavailable, e.g. a constrained dev box). Off by default.

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"
engine="$(cd "$here/.." && pwd)"
repo="$(dp_site "$engine")"

dir="."; source="tell"; signers=""; partial=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) dir="$2"; shift 2;;
    --source) source="$2"; shift 2;;
    --signers) signers="$2"; shift 2;;
    --partial) partial=1; shift;;
    *) dp_die "unknown arg: $1";;
  esac
done

inbox="$dir/inbox"
manifest="$inbox/manifest.json"
[ -f "$manifest" ] || dp_die "no manifest at $manifest"

# --- signature over the entries digest ---
[ -n "$signers" ] || signers="$repo/keys/$source.signers"
digest="$(dp_entries_digest "$manifest")"
mdigest="$(jq -r '.head.digest // empty' "$manifest")"
[ "$digest" = "$mdigest" ] || dp_die "manifest digest mismatch (head=$mdigest computed=$digest)"

if [ "${DP_ALLOW_UNSIGNED:-0}" = "1" ]; then
  dp_log "WARN: signature check skipped (DP_ALLOW_UNSIGNED=1)"
elif ! command -v ssh-keygen >/dev/null 2>&1; then
  dp_die "ssh-keygen not found; cannot verify signature (set DP_ALLOW_UNSIGNED=1 to bypass)"
elif [ ! -f "$signers" ]; then
  dp_die "no registered signer at $signers (set DP_ALLOW_UNSIGNED=1 to bypass)"
else
  sig="$(jq -r '.head.sig // empty' "$manifest")"
  [ -n "$sig" ] || dp_die "manifest head carries no signature"
  # The drop channel signs under its own namespace, so a head from one channel can never
  # replay into the other (docs/transfer.md §B).
  ns="data-pile"; [ "$source" = "drop" ] && ns="data-pile-drop"
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  printf '%s' "$sig" | base64 -d > "$tmp/sig"
  printf '%s' "$digest" | ssh-keygen -Y verify -n "$ns" -I "$source" \
    -f "$signers" -s "$tmp/sig" >/dev/null \
    || dp_die "signature does NOT verify against $signers (namespace $ns)"
  # Cross-check the signer fingerprint matches what pile.yml registered.
  want="$(dp_source_signer "$source" "$repo/pile.yml")"
  if [ -n "$want" ]; then
    got="$(awk '{print $2,$3,$4}' "$signers" | ssh-keygen -lf - 2>/dev/null | awk '{print $2}')"
    [ "$got" = "$want" ] || dp_die "signer fingerprint $got != registered $want"
  fi
  dp_log "OK: signature verifies (signer $source)"
fi

# --- hash-linked chain + per-block ciphertext hashes ---
n="$(jq '.entries | length' "$manifest")"
prev="null"
i=0
held=0; unheld=""
while [ "$i" -lt "$n" ]; do
  seq="$(jq -r ".entries[$i].seq" "$manifest")"
  block="$(jq -r ".entries[$i].block" "$manifest")"
  this="$(jq -r ".entries[$i].this_hash" "$manifest")"
  ph="$(jq -r ".entries[$i].prev_hash" "$manifest")"
  rp="$(jq -r ".entries[$i].ratchet_pub" "$manifest")"

  # Checkable from the manifest alone — these stay fatal in every mode, because the signed
  # digest covers them and a reader holding no bytes at all can still be lied to here.
  [ "$seq" = "$i" ] || dp_die "entry $i out of order (seq=$seq)"
  [ "$ph" = "$prev" ] || dp_die "broken chain at seq $seq (prev_hash=$ph expected=$prev)"
  printf '%s' "$rp" | grep -Eq '^sha256:[0-9a-f]{64}$' || dp_die "bad ratchet_pub at seq $seq"
  kf=""
  if [ "$source" = "drop" ]; then
    # Channel 2: every entry must NAME its age-wrapped per-block key. Naming is a manifest
    # property; having the file is a holding property, so only the latter can be partial.
    kf="$(jq -r ".entries[$i].key // empty" "$manifest")"
    [ -n "$kf" ] || dp_die "drop entry $seq carries no key file (channel 2 requires one)"
  fi

  # Needs the bytes. Absent is fatal unless the caller declared itself a partial holder.
  if [ -f "$inbox/$block" ]; then
    got="sha256:$(dp_sha256_file "$inbox/$block")"
    [ "$got" = "$this" ] || dp_die "block $block tampered at seq $seq ($got != $this)"
    if [ -n "$kf" ] && [ ! -f "$inbox/$kf" ] && [ "$partial" = "0" ]; then
      dp_die "missing key file $kf at seq $seq"
    fi
    held=$((held+1))
  elif [ "$partial" = "1" ]; then
    unheld="$unheld $seq"
  else
    dp_die "missing block file $block at seq $seq (pass --partial if you hold only some)"
  fi

  prev="$this"
  i=$((i+1))
done

# Report the smaller claim as the smaller claim. Never print the full sentinel for a partial run.
if [ "$partial" = "1" ] && [ "$held" -lt "$n" ]; then
  dp_log "OK: chain verifies — $n entries, source '$source' (signature + linkage, no bytes needed)"
  dp_log "PARTIAL: $held/$n block(s) held and hash-verified; NOT held: seq$(dp_ranges "$unheld")"
  echo "verified-partial $held/$n"
else
  dp_log "OK: chain verifies — $n block(s), source '$source'"
  echo "verified"
fi
